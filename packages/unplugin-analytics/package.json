{
  "name": "unplugin-analytics",
  "version": "0.0.13",
  "description": "Universal Analytics Engines Integration",
  "keywords": [
    "analytics",
    "google-analytics",
    "umami",
    "plausible",
    "vite-plugin",
    "unplugin",
    "vite",
    "webpack"
  ],
  "homepage": "https://github.com/yjl9903/unplugin-analytics#readme",
  "bugs": {
    "url": "https://github.com/yjl9903/unplugin-analytics/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yjl9903/unplugin-analytics.git"
  },
  "license": "MIT",
  "author": "XLor",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./*": "./*",
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./vitepress": {
      "types": "./dist/vitepress.d.mts",
      "import": "./dist/vitepress.mjs"
    },
    "./astro": {
      "types": "./dist/astro.d.mts",
      "import": "./dist/astro.mjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.mts",
      "import": "./dist/nuxt.mjs"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "typesVersions": {
    "*": {
      "client": [
        "./client.d.ts"
      ],
      "*": [
        "./dist/*.d.mts",
        "./*"
      ]
    }
  },
  "files": [
    "dist",
    "*.d.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare:nuxt": "nuxt-module-build prepare",
    "test": "vitest",
    "test:ci": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@unplugin-analytics/core": "workspace:*",
    "defu": "^6.1.7",
    "scule": "^1.3.0",
    "unplugin": "^3.3.0"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3 || ^4",
    "@nuxt/schema": "^3 || ^4",
    "esbuild": "*",
    "rollup": "^2 || ^3 || ^4",
    "vite": ">=3.2.7",
    "webpack": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "@nuxt/schema": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
